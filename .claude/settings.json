{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev *)",
      "Bash(npm run build *)",
      "Bash(npm run preview *)",
      "Bash(npm run serve *)",
      "Bash(npm test *)",
      "Bash(npx playwright test *)",
      "Bash(npx playwright show-trace *)",
      "Bash(npx playwright show-report *)",
      "Bash(CI=1 npx playwright test *)",

      "Edit(/**)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(git stash list *)",

      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh auth status *)",
      "Bash(/opt/homebrew/bin/gh pr view *)",
      "Bash(/opt/homebrew/bin/gh pr list *)",
      "Bash(/opt/homebrew/bin/gh pr checks *)",
      "Bash(/opt/homebrew/bin/gh pr diff *)",
      "Bash(/opt/homebrew/bin/gh run view *)",
      "Bash(/opt/homebrew/bin/gh run list *)",
      "Bash(/opt/homebrew/bin/gh issue view *)",
      "Bash(/opt/homebrew/bin/gh issue list *)",

      "Bash(gh pr merge *)",
      "Bash(gh pr edit *)",
      "Bash(/opt/homebrew/bin/gh pr merge *)",
      "Bash(/opt/homebrew/bin/gh pr edit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git rebase *)",

      "Bash(gh pr create *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue create *)",
      "Bash(gh api *)",
      "Bash(/opt/homebrew/bin/gh pr create *)",
      "Bash(/opt/homebrew/bin/gh pr close *)",
      "Bash(/opt/homebrew/bin/gh pr comment *)",
      "Bash(/opt/homebrew/bin/gh issue create *)",
      "Bash(/opt/homebrew/bin/gh api *)",

      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm uninstall *)",
      "Bash(npm remove *)",
      "Bash(npm update *)",
      "Bash(npx playwright install *)",

      "Edit(/.github/workflows/**)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Edit(/vite.config.js)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",

      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * HEAD:main)",
      "Bash(git reset --hard *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",

      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)"
    ]
  }
}
