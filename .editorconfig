# Editors that read this indent with 4 spaces, as ESLint checks (npm run lint).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Markdown uses trailing spaces for line breaks.
[*.md]
trim_trailing_whitespace = false
